# MICEGO — Supabase Edge Function 시크릿 목록 (supabase secrets set --env-file .env.secrets)
# 이 파일은 "어떤 키가 필요한가"의 목록이다. 실제 값은 절대 커밋하지 않는다.
# 각 변수의 의미·기본값: supabase/README.md §3·§8.1, SPEC_LAUNCH.md §10, 프로젝트 문서 '백엔드 배포 런북 v1' Step 8.

# --- Supabase 기본 ---
# 아래 4개는 Supabase Edge 런타임이 자동으로 주입하며, CLI는 SUPABASE_ 접두 시크릿 등록을 거부한다.
# 직접 설정하지 말고 코드가 읽기만 한다는 기록으로만 둔다. (로컬 `supabase functions serve`에서는 .env 로 넘길 수 있음)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# --- 사이트 ---
SITE_BASE_URL=https://micego.kr
SITE_ORIGINS=https://micego.kr,https://www.micego.kr
SUPPORT_EMAIL=
OPS_INBOX=
FROM_ADDRESS=

# --- 알림 발송 ---
NOTIFY_MODE=log                 # log | live  (배포 직후 log → 검증 후 live)
RESEND_API_KEY=

# --- 스팸 방어(D-50) — 사이트 키를 넣은 빌드를 먼저 배포한 뒤 설정. 비우면 검사 생략 ---
TURNSTILE_SECRET=
SMS_VENDOR=solapi               # solapi | aligo
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_SENDER=                     # 사전등록된 발신번호
KAKAO_PF_ID=
ALIGO_KEY=                      # 선택 폴백
ALIGO_USER_ID=

# --- 보안 (각각 openssl rand -hex 32 로 생성, 서로 다른 값) ---
OTP_PEPPER=
IP_HASH_SALT=
CRON_SECRET=                    # DB GUC app.settings.cron_secret 와 동일해야 함 (supabase/README.md §2)
MG_DEMO_OTP=0                   # QA 기간에만 1 (live 모드에서는 코드가 무시함)

# --- 피드백(VOC) 시스템 ---
FEEDBACK_INBOX=
FEEDBACK_FROM=
FEEDBACK_ALLOWED_ORIGINS=https://micego.kr,https://www.micego.kr
FEEDBACK_STAGING_ORIGINS=       # Vercel 프리뷰 도메인 — 매칭되면 is_demo=true
FEEDBACK_IP_PEPPER=             # IP_HASH_SALT 와 다른 값
FEEDBACK_CONSOLE_BASE_URL=https://micego.kr/admin
FEEDBACK_CRON_SECRET=           # CRON_SECRET 와 다른 값. DB GUC app.settings.feedback_cron_secret 에도 같은 값을 넣어야 크론 인증이 통과함
FEEDBACK_DAILY_CAP=500
FEEDBACK_OPS_MAIL_DAILY_CAP=150
FEEDBACK_ACK_PER_EMAIL_DAY=3

# --- 프론트엔드 설정은 시크릿이 아니라 site.config.json 에 넣는다 (anonKey 는 공개 키) ---
